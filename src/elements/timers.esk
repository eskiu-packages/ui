// Timers: use_interval and use_timeout, kept by the host's timers and run on the UI thread.
// Part of <ui> (src/ui.esk imports every part; they are not imported alone).

// A timer while its scope is mounted. The host keeps the clock (ui_set_timer_host); its
// tick reaches the handler as an event, so the handler may set signals.
struct UiTimer { int token; int ms; bool repeat; fn()->void handler; bool armed; bool removed; *Node owner; UiSourceLoc at; }

// The host's side: start(token, ms, repeat) arms a timer, stop(token) disarms it; each tick
// comes back as ui_event_timer(token). With none set, timers never fire.
void ui_set_timer_host(escaping fn(int, int, bool)->void start, escaping fn(int)->void stop) {
    if (ui.has_timer_host) { ui_release_timer_start(ui.timer_start); ui_release_int(ui.timer_stop); }
    ui.timer_start = start;
    ui.timer_stop = stop;
    ui.has_timer_host = true;
}

// Starts a timer with the host (internal).
void _ui_timer_arm(*UiTimer timer) {
    if (timer.ms <= 0 || !ui.has_timer_host) { return; }
    timer.armed = true;
    ui.timer_start(timer.token, timer.ms, timer.repeat);
}

// Stops a timer with the host (internal).
void _ui_timer_disarm(*UiTimer timer) {
    if (!timer.armed) { return; }
    timer.armed = false;
    if (ui.has_timer_host) { ui.timer_stop(timer.token); }
}

// Stops and removes a timer (internal).
void _ui_drop_timer(*UiTimer timer) {
    if (timer.removed) { return; }
    timer.removed = true;
    _ui_timer_disarm(timer);
    for (int i = ui.timers.size - 1; i >= 0; i--) {
        if (ui.timers.data[i] == timer) { ui.timers.remove(i); break; }
    }
}

// The hook behind use_interval and use_timeout; `at` is its call, for an error its handler
// throws (internal).
void _ui_use_timer(int ms, bool repeat, escaping fn()->void handler, UiSourceLoc at) {
    static int tag;
    *Slot slot = ui_slot(7, &tag);
    *UiTimer timer = (*UiTimer)slot.data;
    if (timer != null) { timer.at = at; }
    if (timer == null) {
        timer = alloc<UiTimer>(1);
        timer.token = ++ui.next_timer;
        timer.ms = ms;
        timer.repeat = repeat;
        // The scope that made it, for an error its handler throws (freed with that scope).
        timer.owner = ui.builder;
        timer.at = at;
        slot.data = timer;
        ui.timers.push(timer);
        slot.dispose = void() { _ui_drop_timer(timer); ui_release_closure(timer.handler); free(timer); };
        timer.handler = handler;
        _ui_timer_arm(timer);
        return;
    }
    ui_release_closure(timer.handler);
    timer.handler = handler;
    if (timer.ms != ms || timer.repeat != repeat) {
        _ui_timer_disarm(timer);
        timer.ms = ms;
        timer.repeat = repeat;
        _ui_timer_arm(timer);
    }
}

// `handler` every `ms` milliseconds while the scope is mounted; 0 or less pauses it, and a
// new period restarts it.
void use_interval(int ms, escaping fn()->void handler UI_LOC) {
#ifdef UI_SRCLOC
    _ui_use_timer(ms, true, handler, at);
#else
    _ui_use_timer(ms, true, handler, UiSourceLoc{});
#endif
}

// `handler` once, `ms` milliseconds after the scope mounts (or after `ms` last changed).
void use_timeout(int ms, escaping fn()->void handler UI_LOC) {
#ifdef UI_SRCLOC
    _ui_use_timer(ms, false, handler, at);
#else
    _ui_use_timer(ms, false, handler, UiSourceLoc{});
#endif
}

// The host's side: the timer with `token` fired.
bool ui_event_timer(int token) { return ui_post(Event{token, 0, 12, 0, null}); }

// Runs the handler of the timer that fired, or a frame when it is the frame timer
// (internal).
// The scope of the live timer with `token` (its use_interval or use_timeout), or null
// (internal).
*Node _ui_timer_owner(int token) {
    for (i in 0..ui.timers.size) {
        *UiTimer timer = ui.timers.data[i];
        if (timer.token == token && !timer.removed) { return timer.owner; }
    }
    return null;
}

// "FILE:LINE:COL" for an error the handler of the live timer with `token` threw: its
// use_interval or use_timeout call when that is in the app's code, else where `owner`, its
// scope, was made; null without source positions. The caller frees it (internal).
string _ui_timer_at(int token, *Node owner) {
#ifdef UI_SRCLOC
    for (i in 0..ui.timers.size) {
        *UiTimer timer = ui.timers.data[i];
        if (timer.token != token || timer.removed || timer.at.file == null || !_ui_source_is_app(timer.at.file)) { continue; }
        String text;
        String_appendf(&text, "%s:%d:%d", _ui_source_file(timer.at.file), timer.at.line, timer.at.col);
        return text.data;
    }
#endif
    return _ui_at_text(owner);
}

bool _ui_dispatch_timer_event(*Event event) {
    if (ui.frame_timer != 0 && event.id == ui.frame_timer) { return _ui_run_frames(ui.last_frame_time < 0 ? 0 : ui.last_frame_time + 0.016); }
    for (i in 0..ui.timers.size) {
        *UiTimer timer = ui.timers.data[i];
        if (timer.token != event.id || timer.removed || !timer.armed) { continue; }
        if (!timer.repeat) { timer.armed = false; }
        timer.handler();
        return true;
    }
    return false;
}
